@prefix : <#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xhv: <http://www.w3.org/1999/xhtml/vocab#> .

# SHACL shapes for the ui: vocabulary: menus & plugin entries, and app layouts.

:MenuShape
  a sh:NodeShape ;
  sh:targetClass ui:Menu ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "The display label for the menu" ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:nodeKind sh:IRI ;
    sh:name "menu items" ;
    sh:description "An ordered or unordered list of menu items." ;
    sh:or (
      [ sh:node :OrderedItemShape ]
      [ sh:node :UnorderedItemShape ]
    ) ;
  ] ;
  sh:property [
    sh:path ui:orientation ;
    sh:maxCount 1 ;
    sh:in ( ui:Horizontal ui:Vertical ) ;
    sh:name "orientation" ;
    sh:description "ui:Horizontal or ui:Vertical menu layout" ;
  ] ;
  sh:property [
    sh:path ui:view ;
    sh:maxCount 1 ;
    sh:in ( ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar ) ;
    sh:name "shown as" ;
    sh:description "The view the menu is presented as — a menu-capable kind of ui:View, e.g. ui:Tablist." ;
  ] ;
  sh:property [
    sh:path ui:region ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:in ( ui:Inline ui:Element ui:Modal ui:Floating ui:Window ui:Tab ui:Dropdown ) ]
      [ sh:class ui:Layout ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:name "shown in" ;
    sh:description "Default placement for items that carry no region of their own: a ui:Region KIND (ui:Modal etc.), OR a TARGET region NODE the menu binds to (e.g. a ui:Layout region — the renderer derives its element from the node's own id), OR a legacy target-selector string." ;
  ] .

# THE unified catalog entry: one editable ui:Plugin node is the manifest,
# the catalog/pantry card, AND the mounted item (menus reference it). The
# REQUIRED schema:additionalType picks the kind; the payload contract is
# DELEGATED to the matching kind shape, which owns its schema:url in full.
:PluginShape
  a sh:NodeShape ;
  sh:targetClass ui:Plugin ;
  sh:node :IconMixin, :AttributedMixin ;
  sh:property [
    sh:path schema:additionalType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( ui:Link ui:Component ui:Command ) ;
    sh:name "menu item kind" ;
    sh:description "ui:Link (external URL), ui:Component (custom element), or ui:Command (host command key)." ;
  ] ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display name for menus, buttons, etc." ;
  ] ;
  sh:property [
    sh:path ui:region ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:in ( ui:Inline ui:Element ui:Modal ui:Floating ui:Window ui:Tab ui:Dropdown ) ]
      [ sh:class ui:Layout ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:name "region" ;
    sh:description "Where the plugin's content is placed — a ui:Region KIND (e.g. ui:Tab, ui:Modal), OR a TARGET region NODE it binds to (the renderer derives the element from the node's own id), OR a legacy target-selector string." ;
  ] ;
  sh:property [
    sh:path dcterms:source ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "manifest" ;
    sh:description "Provenance: the flat manifest doc this entry was generated from." ;
  ] ;
  sh:property [
    sh:path schema:description ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "description" ;
    sh:description "User-facing plugin description." ;
  ] ;
  sh:property [
    sh:path dcterms:publisher ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "publisher" ;
    sh:description "Publisher/maintainer of the plugin." ;
  ] ;
  sh:property [
    sh:path schema:keywords ;
    sh:datatype xsd:string ;
    sh:name "topics" ;
    sh:description "Topic categories (Customize tabs) — one string per topic" ;
  ] ;
  sh:property [
    sh:path dcterms:conformsTo ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "shape" ;
    sh:description "SHACL shape the plugin's settings/data conform to. Used to auto-generate forms." ;
  ] ;
  sh:property [
    sh:path dcterms:references ;
    sh:nodeKind sh:IRI ;
    sh:name "data" ;
    sh:description "Plugin's data/settings document." ;
  ] ;
  sh:property [
    sh:path schema:softwareHelp ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "help" ;
    sh:description "Plugin help page." ;
  ] ;
  sh:xone (
    [
      sh:property [ sh:path schema:additionalType ; sh:hasValue ui:Link ] ;
      sh:node :LinkShape ;
    ]
    [
      sh:property [ sh:path schema:additionalType ; sh:hasValue ui:Component ] ;
      sh:node :ComponentShape ;
    ]
    [
      sh:property [ sh:path schema:additionalType ; sh:hasValue ui:Command ] ;
      sh:node :CommandShape ;
    ]
  ) .

# A placement wrapper: WHERE one member sits in ONE menu — position lives on
# the placement, never the shared member. Reorder = swap two positions.
# Recognised by schema:item + schema:position, NOT by an `a schema:ListItem`
# type: serializers still emit the type, but declaring it is optional so a
# hand-authored bare `[ schema:item … ; schema:position … ]` validates too.
:OrderedItemShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:item ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node :UnorderedItemShape ;
    sh:name "item" ;
    sh:description "An ordered menu item." ;
  ] ;
  sh:property [
    sh:path schema:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:name "position" ;
    sh:description "Sort order number within this menu." ;
  ] .

# A direct member (unordered sets), and the target of every wrapper's
# schema:item. No targetClass: bound only via the membership paths, so the
# label rule applies to members REACHABLE from a menu but never to
# free-standing nodes (e.g. ci manifest entries, whose label is optional).
:UnorderedItemShape
  a sh:NodeShape ;
  sh:or (
    [ sh:class ui:Plugin ]
    [ sh:class ui:Link ]
    [ sh:class ui:Component ]
    [ sh:class ui:Command ]
    [ sh:class ui:Menu ]
  ) ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display label" ;
  ] .

:LinkShape
  a sh:NodeShape ;
  sh:targetClass ui:Link ;
  sh:node :IconMixin, :AttributedMixin ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "The display label for the link" ;
  ] ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ;
    sh:name "url" ;
    sh:description "The URL the link opens — an IRI or a URL string" ;
  ] .

:ComponentShape
  a sh:NodeShape ;
  sh:targetClass ui:Component ;
  sh:node :IconMixin, :AttributedMixin ;
  sh:property [
    sh:path ui:label ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display name for menus, buttons etc." ;
  ] ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "/[a-z][a-z0-9]*(-[a-z0-9]+)+(\\.esm|\\.min)?\\.js$" ;
    sh:name "module URL" ;
    sh:description "The ES module that defines the custom element." ;
  ] .

# NO sh:targetClass on purpose: this is the ENTRY contract for
# kind-Command plugins, reached only through :PluginShape's sh:xone. Bare
# `a ui:Command` registry fragments are documentation and stay unbound.
:CommandShape
  a sh:NodeShape ;
  sh:node :AttributedMixin ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "#[A-Za-z][A-Za-z0-9]*$" ;
    sh:name "command URL" ;
    sh:description "A fragment IRI in the host app's command registry document which points to one of the app's commands." ;
  ] .

# ── menu variants ─────────────────────────────────────────────────────────
# One shape per menu-capable ui:view. Each is a ui:Menu and carries a menu's
# head fields; the shape pairs the view with the membership rule it implies.

:MenubarMenuShape
  a sh:NodeShape ;
  sh:node :MenuShape ;
  sh:property [
    sh:path ui:view ;
    sh:hasValue ui:Menubar ;
    sh:maxCount 1 ;
    sh:in ( ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar ) ;
    sh:name "shown as" ;
    sh:description "The menu's view: ui:Menubar." ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:node :OrderedItemShape ]
      [ sh:node :UnorderedItemShape ]
    ) ;
    sh:name "menu items" ;
    sh:description "The items of a menubar. Any item may itself be a menu, which nests as a submenu." ;
  ] .

:MenuButtonMenuShape
  a sh:NodeShape ;
  sh:node :MenuShape ;
  sh:property [
    sh:path ui:view ;
    sh:hasValue ui:MenuButton ;
    sh:maxCount 1 ;
    sh:in ( ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar ) ;
    sh:name "shown as" ;
    sh:description "The menu's view: ui:MenuButton." ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:node :OrderedSubmenuItemShape ]
      [ sh:node :SubmenuMemberShape ]
    ) ;
    sh:name "menu item" ;
    sh:description "The one item of a menu button: a menu, whose own items are what the button drops." ;
  ] .

:TablistMenuShape
  a sh:NodeShape ;
  sh:node :MenuShape ;
  sh:property [
    sh:path ui:view ;
    sh:hasValue ui:Tablist ;
    sh:maxCount 1 ;
    sh:in ( ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar ) ;
    sh:name "shown as" ;
    sh:description "The menu's view: ui:Tablist." ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:node :OrderedFlatItemShape ]
      [ sh:node :FlatMemberShape ]
    ) ;
    sh:name "menu items" ;
    sh:description "The items of a tablist, one per tab. No item is itself a menu — tabs do not nest." ;
  ] .

:TreeMenuShape
  a sh:NodeShape ;
  sh:node :MenuShape ;
  sh:property [
    sh:path ui:view ;
    sh:hasValue ui:Tree ;
    sh:maxCount 1 ;
    sh:in ( ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar ) ;
    sh:name "shown as" ;
    sh:description "The menu's view: ui:Tree." ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:node :OrderedItemShape ]
      [ sh:node :UnorderedItemShape ]
    ) ;
    sh:name "menu items" ;
    sh:description "The items of a tree. Any item may itself be a menu, which nests as a branch." ;
  ] .

:ToolbarMenuShape
  a sh:NodeShape ;
  sh:node :MenuShape ;
  sh:property [
    sh:path ui:view ;
    sh:hasValue ui:Toolbar ;
    sh:maxCount 1 ;
    sh:in ( ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar ) ;
    sh:name "shown as" ;
    sh:description "The menu's view: ui:Toolbar." ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:node :OrderedFlatItemShape ]
      [ sh:node :FlatMemberShape ]
    ) ;
    sh:name "menu items" ;
    sh:description "The items of a toolbar, each one a button. No item is itself a menu — a toolbar has no second level." ;
  ] .

# A member that is NOT a menu: the leaf kinds a flat menu holds.
:FlatMemberShape
  a sh:NodeShape ;
  sh:or (
    [ sh:class ui:Plugin ]
    [ sh:class ui:Link ]
    [ sh:class ui:Component ]
    [ sh:class ui:Command ]
  ) ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display label" ;
  ] .

# A member that IS a menu — a submenu.
:SubmenuMemberShape
  a sh:NodeShape ;
  sh:class ui:Menu ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display label" ;
  ] .

:OrderedFlatItemShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:item ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node :FlatMemberShape ;
    sh:name "item" ;
    sh:description "An ordered item that is not a menu." ;
  ] ;
  sh:property [
    sh:path schema:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:name "position" ;
    sh:description "Sort order number within this menu." ;
  ] .

:OrderedSubmenuItemShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:item ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node :SubmenuMemberShape ;
    sh:name "item" ;
    sh:description "An ordered item that is a menu." ;
  ] ;
  sh:property [
    sh:path schema:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:name "position" ;
    sh:description "Sort order number within this menu." ;
  ] .

# ── mixins ────────────────────────────────────────────────────────────────
:IconMixin
  a sh:NodeShape ;
  sh:property [
    sh:path ui:icon ;
    sh:maxCount 1 ;
    sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ;
    sh:name "icon" ;
    sh:description "URL of an image or emoji/text string" ;
  ] .

:AttributedMixin
  a sh:NodeShape ;
  sh:property [
    sh:path schema:additionalProperty ;
    sh:node :PropertyValueShape ;
    sh:name "attribute" ;
    sh:description "plugin parameter key/value pairs" ;
  ] .

:PropertyValueShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "name" ;
    sh:description "Attribute name" ;
  ] ;
  sh:property [
    sh:path schema:value ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:name "value" ;
    sh:description "Attribute value" ;
  ] .


# ── App layouts ──────────────────────────────────────────────────────────

:LayoutShape
  a sh:NodeShape ;
  sh:targetClass ui:Layout ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "REQUIRED. The region's accessible name — emitted as aria-label on the landmark element (an explicit aria-label / aria-labelledby attribute overrides it). Required so every landmark carries a name: a role=region (<section>) is a landmark ONLY with one, and repeated nav/main need distinct names. The root layout IS the <body>, whose label is not emitted." ;
  ] ;
  sh:property [
    sh:path ui:orientation ;
    sh:maxCount 1 ;
    sh:in ( ui:Horizontal ui:Vertical ) ;
    sh:name "orientation" ;
    sh:description "Flow axis for the parts: ui:Vertical (default — a page stacks) or ui:Horizontal" ;
  ] ;
  sh:property [
    sh:path ui:columns ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:maxInclusive 6 ;
    sh:name "columns" ;
    sh:description "Render the parts as a grid with this many columns (overrides orientation flow)" ;
  ] ;
  sh:property [
    sh:path xhv:role ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in ( "banner" "main" "navigation" "contentinfo" "complementary" "region" "document" "application" ) ;
    sh:name "role" ;
    sh:description "REQUIRED role (the XHTML/RDFa `role` predicate). Landmark tokens map to native elements: banner→header, main→main, navigation→nav, contentinfo→footer, complementary→aside, region→section (region also needs aria-label). document/application are for the ROOT layout (which IS the <body>): the compiler ignores the root's role and emits <body> plus its class/attrs. Complete landmark set, incl. main." ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:name "entries" ;
    sh:description "Region membership, ordered OR unordered (as the menu items): an ordered schema:ListItem wrapper (schema:item names the nested ui:Layout region or ui:Component leaf, schema:position its visual order) — the wrapper may be a blank node — or, for an unordered / single-item region, the ui:Layout / ui:Component member directly (an IRI). An empty region is a placeholder pane other items target (region= selector). Replaces the retired ui:parts rdf:Collection (2026-07-19)." ;
    sh:or (
      [ sh:node :LayoutEntryShape ]
      [ sh:node :LayoutMemberShape ]
    ) ;
  ] ;
  sh:property [
    sh:path schema:additionalProperty ;
    sh:node :PropertyValueShape ;
    sh:name "attribute" ;
    sh:description "HTML attributes emitted on the region's element (class, aria-label, id) as schema:PropertyValue pairs" ;
  ] .

# A placement wrapper: WHERE one member sits in ONE region — recognised by its
# schema:item + schema:position, NOT by an `a schema:ListItem` type. Serializers
# still EMIT the type (self-describing); the shape makes declaring it optional,
# so a hand-authored bare `[ schema:item … ; schema:position … ]` also validates.
:LayoutEntryShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:item ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node :LayoutMemberShape ;
    sh:name "item" ;
    sh:description "The nested ui:Layout region or ui:Component leaf this placement mounts." ;
  ] ;
  sh:property [
    sh:path schema:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:name "position" ;
    sh:description "Visual order within this region (ascending; sequential 1..n by convention)." ;
  ] .

# A direct member (unordered / single-item regions) AND the target of every
# wrapper's schema:item: a nested ui:Layout region or a ui:Component leaf. No
# targetClass — bound only via the membership paths, mirroring the menu
# :UnorderedItemShape above, minus its label rule (layout regions and leaves are
# not menu items and need no ui:label).
:LayoutMemberShape
  a sh:NodeShape ;
  sh:or (
    [ sh:class ui:Layout ]      # a nested region
    [ sh:class ui:Component ]   # a mounted custom element
    [ sh:class ui:Menu ]        # rendered as a menu (sol-menu / sol-tabs)
    [ sh:class ui:Link ]        # its schema:url transcluded / framed
    [ sh:class ui:Plugin ]      # a cataloged plugin (kind picks Link/Component)
  ) .

# The app's own metadata node — a schema:SoftwareApplication (or the WEB
# subtype for generated standalone web apps), no new class. Both are targeted:
# a native host like data-kitchen is a SoftwareApplication, not a web app.
:AppShape
  a sh:NodeShape ;
  sh:targetClass schema:WebApplication ;
  sh:targetClass schema:SoftwareApplication ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "name" ;
    sh:description "The app's name (the generated page title)" ;
  ] ;
  sh:property [
    sh:path ui:icon ;
    sh:maxCount 1 ;
    sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ;
    sh:name "icon" ;
    sh:description "Icon: a URL (IRI or string) used as the favicon, or an emoji string" ;
  ] ;
  sh:property [
    sh:path schema:inLanguage ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "language" ;
    sh:description "The language of the app's content, as a BCP 47 language tag" ;
  ] ;
  sh:property [
    sh:path ui:layout ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "layout" ;
    sh:description "The app's root ui:Layout" ;
  ] .
