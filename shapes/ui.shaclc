PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <http://schema.org/>
PREFIX ui: <http://www.w3.org/ns/ui#>
PREFIX xhv: <http://www.w3.org/1999/xhtml/vocab#>

shape <#MenuShape> -> ui:Menu {
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "The display label for the menu"
    % .
    schema:itemListElement IRI @<#OrderedItemShape>|@<#UnorderedItemShape> %
        sh:name "menu items" ; sh:description "An ordered or unordered list of menu items."
    % .
    ui:orientation [0..1] in=[ui:Horizontal ui:Vertical] %
        sh:name "orientation" ; sh:description "ui:Horizontal or ui:Vertical menu layout"
    % .
    ui:view [0..1] in=[ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar] %
        sh:name "shown as" ; sh:description "The view the menu is presented as — a menu-capable kind of ui:View, e.g. ui:Tablist."
    % .
    ui:region [0..1] in=[ui:Inline ui:Element ui:Modal ui:Floating ui:Window ui:Tab ui:Dropdown]|ui:Layout|xsd:string %
        sh:name "shown in" ; sh:description "Default placement for items that carry no region of their own: a ui:Region KIND (ui:Modal etc.), OR a TARGET region NODE the menu binds to (e.g. a ui:Layout region — the renderer derives its element from the node's own id), OR a legacy target-selector string."
    % .
}

shape <#OrderedItemShape> {
    schema:item IRI [1..1] @<#UnorderedItemShape> %
        sh:name "item" ; sh:description "An ordered menu item."
    % .
    schema:position xsd:integer [1..1] %
        sh:name "position" ; sh:description "Sort order number within this menu."
    % .
}

shape <#UnorderedItemShape> {
    class=ui:Plugin|class=ui:Link|class=ui:Component|class=ui:Command|class=ui:Menu .
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "Display label"
    % .
}

shape <#PluginShape> -> ui:Plugin ;
    sh:node <#IconMixin>, <#AttributedMixin> ;
    sh:xone ([
        sh:property [
            sh:path schema:additionalType ;
            sh:hasValue ui:Link
        ] ;
        sh:node <#LinkShape>
    ] [
        sh:property [
            sh:path schema:additionalType ;
            sh:hasValue ui:Component
        ] ;
        sh:node <#ComponentShape>
    ] [
        sh:property [
            sh:path schema:additionalType ;
            sh:hasValue ui:Command
        ] ;
        sh:node <#CommandShape>
    ]) {
    schema:additionalType [1..1] in=[ui:Link ui:Component ui:Command] %
        sh:name "menu item kind" ; sh:description "ui:Link (external URL), ui:Component (custom element), or ui:Command (host command key)."
    % .
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "Display name for menus, buttons, etc."
    % .
    ui:region [0..1] in=[ui:Inline ui:Element ui:Modal ui:Floating ui:Window ui:Tab ui:Dropdown]|ui:Layout|xsd:string %
        sh:name "region" ; sh:description "Where the plugin's content is placed — a ui:Region KIND (e.g. ui:Tab, ui:Modal), OR a TARGET region NODE it binds to (the renderer derives the element from the node's own id), OR a legacy target-selector string."
    % .
    dcterms:source IRI [0..1] %
        sh:name "manifest" ; sh:description "Provenance: the flat manifest doc this entry was generated from."
    % .
    schema:description xsd:string [0..1] %
        sh:name "description" ; sh:description "User-facing plugin description."
    % .
    dcterms:publisher xsd:string [0..1] %
        sh:name "publisher" ; sh:description "Publisher/maintainer of the plugin."
    % .
    schema:keywords xsd:string %
        sh:name "topics" ; sh:description "Topic categories (Customize tabs) — one string per topic"
    % .
    dcterms:conformsTo IRI [0..1] %
        sh:name "shape" ; sh:description "SHACL shape the plugin's settings/data conform to. Used to auto-generate forms."
    % .
    dcterms:references IRI %
        sh:name "data" ; sh:description "Plugin's data/settings document."
    % .
    schema:softwareHelp IRI [0..1] %
        sh:name "help" ; sh:description "Plugin help page."
    % .
}

shape <#IconMixin> {
    ui:icon [0..1] IRI|xsd:string %
        sh:name "icon" ; sh:description "URL of an image or emoji/text string"
    % .
}

shape <#AttributedMixin> {
    schema:additionalProperty @<#PropertyValueShape> %
        sh:name "attribute" ; sh:description "plugin parameter key/value pairs"
    % .
}

shape <#LinkShape> -> ui:Link ;
    sh:node <#IconMixin>, <#AttributedMixin> {
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "The display label for the link"
    % .
    schema:url [1..1] IRI|xsd:string %
        sh:name "url" ; sh:description "The URL the link opens — an IRI or a URL string"
    % .
}

shape <#ComponentShape> -> ui:Component ;
    sh:node <#IconMixin>, <#AttributedMixin> {
    ui:label xsd:string [0..1] %
        sh:name "label" ; sh:description "Display name for menus, buttons etc."
    % .
    schema:url IRI [1..1] pattern="/[a-z][a-z0-9]*(-[a-z0-9]+)+(\\.esm|\\.min)?\\.js$" %
        sh:name "module URL" ; sh:description "The ES module that defines the custom element."
    % .
}

shape <#CommandShape> ;
    sh:node <#AttributedMixin> {
    schema:url IRI [1..1] pattern="#[A-Za-z][A-Za-z0-9]*$" %
        sh:name "command URL" ; sh:description "A fragment IRI in the host app's command registry document which points to one of the app's commands."
    % .
}

shape <#MenubarMenuShape> ;
    sh:node <#MenuShape> {
    ui:view [0..1] in=[ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar] hasValue=ui:Menubar %
        sh:name "shown as" ; sh:description "The menu's view: ui:Menubar."
    % .
    schema:itemListElement IRI [1..*] @<#OrderedItemShape>|@<#UnorderedItemShape> %
        sh:name "menu items" ; sh:description "The items of a menubar. Any item may itself be a menu, which nests as a submenu."
    % .
}

shape <#MenuButtonMenuShape> ;
    sh:node <#MenuShape> {
    ui:view [0..1] in=[ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar] hasValue=ui:MenuButton %
        sh:name "shown as" ; sh:description "The menu's view: ui:MenuButton."
    % .
    schema:itemListElement IRI [1..1] @<#OrderedSubmenuItemShape>|@<#SubmenuMemberShape> %
        sh:name "menu item" ; sh:description "The one item of a menu button: a menu, whose own items are what the button drops."
    % .
}

shape <#OrderedSubmenuItemShape> {
    schema:item IRI [1..1] @<#SubmenuMemberShape> %
        sh:name "item" ; sh:description "An ordered item that is a menu."
    % .
    schema:position xsd:integer [1..1] %
        sh:name "position" ; sh:description "Sort order number within this menu."
    % .
}

shape <#SubmenuMemberShape> {
    class=ui:Menu .
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "Display label"
    % .
}

shape <#TablistMenuShape> ;
    sh:node <#MenuShape> {
    ui:view [0..1] in=[ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar] hasValue=ui:Tablist %
        sh:name "shown as" ; sh:description "The menu's view: ui:Tablist."
    % .
    schema:itemListElement IRI [1..*] @<#OrderedFlatItemShape>|@<#FlatMemberShape> %
        sh:name "menu items" ; sh:description "The items of a tablist, one per tab. No item is itself a menu — tabs do not nest."
    % .
}

shape <#OrderedFlatItemShape> {
    schema:item IRI [1..1] @<#FlatMemberShape> %
        sh:name "item" ; sh:description "An ordered item that is not a menu."
    % .
    schema:position xsd:integer [1..1] %
        sh:name "position" ; sh:description "Sort order number within this menu."
    % .
}

shape <#FlatMemberShape> {
    class=ui:Plugin|class=ui:Link|class=ui:Component|class=ui:Command .
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "Display label"
    % .
}

shape <#TreeMenuShape> ;
    sh:node <#MenuShape> {
    ui:view [0..1] in=[ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar] hasValue=ui:Tree %
        sh:name "shown as" ; sh:description "The menu's view: ui:Tree."
    % .
    schema:itemListElement IRI [1..*] @<#OrderedItemShape>|@<#UnorderedItemShape> %
        sh:name "menu items" ; sh:description "The items of a tree. Any item may itself be a menu, which nests as a branch."
    % .
}

shape <#ToolbarMenuShape> ;
    sh:node <#MenuShape> {
    ui:view [0..1] in=[ui:Menubar ui:MenuButton ui:Tablist ui:Tree ui:Toolbar] hasValue=ui:Toolbar %
        sh:name "shown as" ; sh:description "The menu's view: ui:Toolbar."
    % .
    schema:itemListElement IRI [1..*] @<#OrderedFlatItemShape>|@<#FlatMemberShape> %
        sh:name "menu items" ; sh:description "The items of a toolbar, each one a button. No item is itself a menu — a toolbar has no second level."
    % .
}

shape <#PropertyValueShape> {
    schema:name xsd:string [1..1] %
        sh:name "name" ; sh:description "Attribute name"
    % .
    schema:value [1..1] %
        sh:name "value" ; sh:description "Attribute value"
    % .
}

shape <#LayoutShape> -> ui:Layout {
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "REQUIRED. The region's accessible name — emitted as aria-label on the landmark element (an explicit aria-label / aria-labelledby attribute overrides it). Required so every landmark carries a name: a role=region (<section>) is a landmark ONLY with one, and repeated nav/main need distinct names. The root layout IS the <body>, whose label is not emitted."
    % .
    ui:orientation [0..1] in=[ui:Horizontal ui:Vertical] %
        sh:name "orientation" ; sh:description "Flow axis for the parts: ui:Vertical (default — a page stacks) or ui:Horizontal"
    % .
    ui:columns xsd:integer [0..1] minInclusive=1 maxInclusive=6 %
        sh:name "columns" ; sh:description "Render the parts as a grid with this many columns (overrides orientation flow)"
    % .
    xhv:role xsd:string [1..1] in=["banner" "main" "navigation" "contentinfo" "complementary" "region" "document" "application"] %
        sh:name "role" ; sh:description "REQUIRED role (the XHTML/RDFa `role` predicate). Landmark tokens map to native elements: banner→header, main→main, navigation→nav, contentinfo→footer, complementary→aside, region→section (region also needs aria-label). document/application are for the ROOT layout (which IS the <body>): the compiler ignores the root's role and emits <body> plus its class/attrs. Complete landmark set, incl. main."
    % .
    schema:itemListElement @<#LayoutEntryShape>|@<#LayoutMemberShape> %
        sh:name "entries" ; sh:description "Region membership, ordered OR unordered (as the menu items): an ordered schema:ListItem wrapper (schema:item names the nested ui:Layout region or ui:Component leaf, schema:position its visual order) — the wrapper may be a blank node — or, for an unordered / single-item region, the ui:Layout / ui:Component member directly (an IRI). An empty region is a placeholder pane other items target (region= selector). Replaces the retired ui:parts rdf:Collection (2026-07-19)."
    % .
    schema:additionalProperty @<#PropertyValueShape> %
        sh:name "attribute" ; sh:description "HTML attributes emitted on the region's element (class, aria-label, id) as schema:PropertyValue pairs"
    % .
}

shape <#LayoutEntryShape> {
    schema:item IRI [1..1] @<#LayoutMemberShape> %
        sh:name "item" ; sh:description "The nested ui:Layout region or ui:Component leaf this placement mounts."
    % .
    schema:position xsd:integer [1..1] %
        sh:name "position" ; sh:description "Visual order within this region (ascending; sequential 1..n by convention)."
    % .
}

shape <#LayoutMemberShape> {
    class=ui:Layout|class=ui:Component|class=ui:Menu|class=ui:Link|class=ui:Plugin .
}

shape <#AppShape> -> schema:WebApplication schema:SoftwareApplication {
    schema:name xsd:string [1..1] %
        sh:name "name" ; sh:description "The app's name (the generated page title)"
    % .
    ui:icon [0..1] IRI|xsd:string %
        sh:name "icon" ; sh:description "Icon: a URL (IRI or string) used as the favicon, or an emoji string"
    % .
    schema:inLanguage xsd:string [0..1] %
        sh:name "language" ; sh:description "The language of the app's content, as a BCP 47 language tag"
    % .
    ui:layout IRI [1..1] %
        sh:name "layout" ; sh:description "The app's root ui:Layout"
    % .
}
